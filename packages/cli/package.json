{
  "name": "@granary/cli",
  "version": "0.0.1",
  "private": true,
  "description": "Ship versioned docs and source as local context for coding agents.",
  "license": "MIT",
  "bin": {
    "granary": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@granary/core": "workspace:*",
    "@granary/plugins": "workspace:*",
    "@granary/sdk": "workspace:*",
    "ink": "^8.0.0",
    "jiti": "^2.7.0",
    "maltty": "1.0.0-rc.0",
    "react": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "massaman": "^0.5.2"
  },
  "engines": {
    "node": ">=26"
  }
}

{
  "name": "@granary/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "default": "./dist/workspace.js"
    },
    "./packs": {
      "types": "./dist/packs.d.ts",
      "default": "./dist/packs.js"
    },
    "./updates": {
      "types": "./dist/updates.d.ts",
      "default": "./dist/updates.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "almanac-md": "0.4.0",
    "massaman": "^0.5.2",
    "zod": "^4.6.5"
  }
}

{
  "include": [
    "README.md",
    "VISION.md",
    "contributing/**/*.md",
    "docs/**/*.md",
    "docs/**/*.mdx",
    "packages/*/docs/**/*.md",
    ".context/docs/**/*.md"
  ],
  "links": [],
  "targets": {
    "path": "AGENTS.md",
    "regions": [
      {
        "tags": { "start": "<standards-index>", "end": "</standards-index>" },
        "include": ".context/docs/**/*.md"
      },
      {
        "tags": { "start": "<docs-index>", "end": "</docs-index>" },
        "exclude": ".context/**"
      }
    ]
  }
}
